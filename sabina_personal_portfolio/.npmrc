# @c3studium/valecms je soukromý balíček na GitHub Packages.
# Token tu není — dosadí se z proměnné GITHUB_PACKAGES_TOKEN při každém installu,
# takže tenhle soubor patří do gitu. Na Vercelu i Railway stačí tu proměnnou
# nastavit (GitHub classic PAT se scope read:packages) a nic dalšího.

@c3studium:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
